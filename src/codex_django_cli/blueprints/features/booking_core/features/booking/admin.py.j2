"""Scaffold-owned admin wiring for resource-slot booking."""


from django.contrib import admin

from .booking_settings import BookingSettings
from .models import (
    Appointment,
    Master,
    MasterDayOff,
    MasterWorkingDay,
    Service,
    ServiceCategory,
)


class MasterWorkingDayInline(admin.TabularInline):
    model = MasterWorkingDay
    extra = 0


class MasterDayOffInline(admin.TabularInline):
    model = MasterDayOff
    extra = 0


@admin.register(ServiceCategory)
class ServiceCategoryAdmin(admin.ModelAdmin):
    list_display = ("name",)
    search_fields = ("name",)


@admin.register(Master)
class MasterAdmin(admin.ModelAdmin):
    list_display = ("name", "user", "status")
    list_filter = ("status", "categories")
    search_fields = ("name", "user__email")
    inlines = [MasterWorkingDayInline, MasterDayOffInline]


@admin.register(Service)
class ServiceAdmin(admin.ModelAdmin):
    list_display = ("name", "category", "duration")
    list_filter = ("category",)
    search_fields = ("name",)
    filter_horizontal = ("masters",)


@admin.register(Appointment)
class AppointmentAdmin(admin.ModelAdmin):
    list_display = ("client", "master", "service", "datetime_start", "status")
    list_filter = ("status", "master")
    search_fields = ("client__email", "master__name")
    date_hierarchy = "datetime_start"
    readonly_fields = ("datetime_start", "duration_minutes")


@admin.register(BookingSettings)
class BookingSettingsAdmin(admin.ModelAdmin):
    fieldsets = [
        (
            "Resource Slot Grid",
            {
                "fields": [
                    "step_minutes",
                    "default_buffer_between_minutes",
                    "min_advance_minutes",
                    "max_advance_days",
                ]
            },
        ),
        (
            "Default Resource Working Hours",
            {
                "fields": [
                    "monday_is_closed",
                    "work_start_monday",
                    "work_end_monday",
                    "tuesday_is_closed",
                    "work_start_tuesday",
                    "work_end_tuesday",
                    "wednesday_is_closed",
                    "work_start_wednesday",
                    "work_end_wednesday",
                    "thursday_is_closed",
                    "work_start_thursday",
                    "work_end_thursday",
                    "friday_is_closed",
                    "work_start_friday",
                    "work_end_friday",
                    "saturday_is_closed",
                    "work_start_saturday",
                    "work_end_saturday",
                    "sunday_is_closed",
                    "work_start_sunday",
                    "work_end_sunday",
                ]
            },
        ),
    ]
