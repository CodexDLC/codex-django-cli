import secrets
from typing import ClassVar

from django.db import models
{%- if enable_i18n %}
from django.utils.translation import gettext_lazy as _
{%- else %}
def _(message: str) -> str:
    return message
{%- endif %}


class Thread(models.Model):
    class Status(models.TextChoices):
        OPEN = "open", _("Open")
        PROCESSED = "processed", _("Processed")
        SPAM = "spam", _("Spam")
        ARCHIVED = "archived", _("Archived")

    class Channel(models.TextChoices):
        EMAIL = "email", _("Email")
        WHATSAPP = "whatsapp", _("WhatsApp")
        TELEGRAM = "telegram", _("Telegram")

    thread_key = models.CharField(_("thread key"), max_length=64, unique=True, db_index=True, editable=False)
    subject = models.CharField(_("subject"), max_length=255, blank=True)
    sender_name = models.CharField(_("sender name"), max_length=128, blank=True)
    sender_email = models.EmailField(_("sender email"), blank=True)
    sender_phone = models.CharField(_("sender phone"), max_length=50, blank=True)
    status = models.CharField(_("status"), max_length=16, choices=Status.choices, default=Status.OPEN, db_index=True)
    topic = models.CharField(_("topic"), max_length=64, blank=True, db_index=True)
    source = models.CharField(_("source"), max_length=32, blank=True, db_index=True)
    channel = models.CharField(_("channel"), max_length=32, choices=Channel.choices, default=Channel.EMAIL)
    is_read = models.BooleanField(_("read"), default=False, db_index=True)
    is_archived = models.BooleanField(_("archived"), default=False, db_index=True)
    last_activity_at = models.DateTimeField(_("last activity at"), auto_now=True, db_index=True)
    created_at = models.DateTimeField(_("created at"), auto_now_add=True)
    updated_at = models.DateTimeField(_("updated at"), auto_now=True)

    class Meta:
        verbose_name = _("Thread")
        verbose_name_plural = _("Threads")
        ordering: ClassVar[list[str]] = ["-last_activity_at"]

    def save(self, *args, **kwargs):
        if not self.thread_key:
            self.thread_key = secrets.token_urlsafe(48)
        super().save(*args, **kwargs)

    def __str__(self) -> str:
        return self.subject or self.sender_email or self.thread_key
