from typing import ClassVar

from django.db import models
{%- if enable_i18n %}
from django.utils.translation import gettext_lazy as _
{%- else %}
def _(message: str) -> str:
    return message
{%- endif %}

from .thread import Thread


class Message(models.Model):
    class Direction(models.TextChoices):
        INBOUND = "inbound", _("Inbound")
        OUTBOUND = "outbound", _("Outbound")

    thread = models.ForeignKey(Thread, on_delete=models.CASCADE, related_name="messages", verbose_name=_("thread"))
    direction = models.CharField(_("direction"), max_length=16, choices=Direction.choices)
    sender_name = models.CharField(_("sender name"), max_length=128, blank=True)
    sender_email = models.EmailField(_("sender email"), blank=True)
    recipient_email = models.EmailField(_("recipient email"), blank=True)
    subject = models.CharField(_("subject"), max_length=255, blank=True)
    body = models.TextField(_("body"))
    source = models.CharField(_("source"), max_length=32, blank=True)
    channel = models.CharField(_("channel"), max_length=32, default="email")
    message_id_header = models.CharField(_("Message-ID header"), max_length=255, blank=True, db_index=True)
    in_reply_to_header = models.CharField(_("In-Reply-To header"), max_length=255, blank=True)
    references_header = models.TextField(_("References header"), blank=True)
    created_at = models.DateTimeField(_("created at"), auto_now_add=True, db_index=True)
    updated_at = models.DateTimeField(_("updated at"), auto_now=True)

    class Meta:
        verbose_name = _("Message")
        verbose_name_plural = _("Messages")
        ordering: ClassVar[list[str]] = ["created_at"]

    def __str__(self) -> str:
        return self.subject or self.body[:60]
