from __future__ import annotations

from typing import Any

from codex_django.messaging.cabinet import MessagingActionResult, MessagingCabinetPresenter
from django.contrib import messages
from django.http import HttpRequest, HttpResponse, HttpResponseRedirect
from django.shortcuts import redirect, render
from django.urls import reverse
from django.views import View

from ..services import get_messaging_bridge, get_messaging_workflow_service


class MessagingCabinetView(View):
    template_name = ""
    presenter_class = MessagingCabinetPresenter

    def setup(self, request: HttpRequest, *args: Any, **kwargs: Any) -> None:
        request.cabinet_module = "messaging"
        super().setup(request, *args, **kwargs)

    @property
    def bridge(self):
        return get_messaging_bridge()

    @property
    def presenter(self) -> MessagingCabinetPresenter:
        return self.presenter_class()

    def render_context(self, request: HttpRequest, context: dict[str, Any]) -> HttpResponse:
        return render(request, self.template_name, context)

    def redirect_from_result(self, result: MessagingActionResult, fallback_url: str) -> HttpResponseRedirect:
        if result.ok:
            messages.success(self.request, result.message)
        else:
            messages.error(self.request, result.message)
        return redirect(result.target_url or fallback_url)


class MessagingMailboxView(MessagingCabinetView):
    template_name = "cabinet/messaging/mailbox.html"

    def get(self, request: HttpRequest) -> HttpResponse:
        state = self.bridge.get_mailbox_state(
            user=request.user,
            folder=str(request.GET.get("folder") or "inbox"),
            filters=request.GET,
        )
        return self.render_context(request, self.presenter.mailbox_context(state))


class MessagingThreadView(MessagingMailboxView):
    def get(self, request: HttpRequest, thread_id: int) -> HttpResponse:
        state = self.bridge.get_mailbox_state(
            user=request.user,
            folder=str(request.GET.get("folder") or "inbox"),
            thread_id=str(thread_id),
            filters=request.GET,
        )
        return self.render_context(request, self.presenter.mailbox_context(state))

    def post(self, request: HttpRequest, thread_id: int) -> HttpResponseRedirect:
        result = get_messaging_workflow_service().dispatch(
            str(request.POST.get("action") or "reply"),
            user=request.user,
            thread_id=str(thread_id),
            payload=request.POST,
        )
        return self.redirect_from_result(
            result,
            reverse("cabinet:messaging_thread", kwargs={"thread_id": thread_id}),
        )


