class MessagingCampaignFormView(MessagingCabinetView):
    template_name = "cabinet/messaging/campaign_form.html"

    def get(self, request: HttpRequest) -> HttpResponse:
        state = self.bridge.get_campaign_composer_state(user=request.user)
        return self.render_context(request, self.presenter.campaign_composer_context(state))

    def post(self, request: HttpRequest) -> HttpResponseRedirect:
        result = get_messaging_workflow_service().save_campaign(user=request.user, payload=request.POST)
        return self.redirect_from_result(result, reverse("cabinet:messaging_campaigns"))


class MessagingCampaignDetailView(MessagingCampaignFormView):
    def get(self, request: HttpRequest, campaign_id: int) -> HttpResponse:
        state = self.bridge.get_campaign_composer_state(user=request.user, campaign_id=str(campaign_id))
        return self.render_context(request, self.presenter.campaign_composer_context(state))

    def post(self, request: HttpRequest, campaign_id: int) -> HttpResponseRedirect:
        workflow = get_messaging_workflow_service()
        action = str(request.POST.get("action") or "save_campaign")
        result = workflow.dispatch(action, user=request.user, campaign_id=str(campaign_id), payload=request.POST)
        return self.redirect_from_result(
            result,
            reverse("cabinet:messaging_campaign_detail", kwargs={"campaign_id": campaign_id}),
        )


