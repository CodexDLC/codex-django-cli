from typing import Any

from codex_django.cabinet import (
    ChartDatasetData,
    ListItem,
    ListWidgetData,
    MetricWidgetData,
    ReportChartData,
    ReportPageData,
    ReportSummaryCardData,
    ReportTabData,
    ReportTableData,
    TableColumn,
    resolve_report_period,
)
from codex_django.cabinet.selector.dashboard import DashboardSelector
from django.http import HttpRequest
{%- if enable_i18n %}
from django.utils.translation import gettext_lazy as _
{%- else %}
def _(message: str) -> str:
    return message
{%- endif %}


class AnalyticsService:
    """Cabinet analytics — dashboard providers and report page data.

    Each static method is independently testable without HTTP context.
    Dashboard providers are registered below via @DashboardSelector.extend.
    """

    @staticmethod
    def get_kpi_metrics() -> dict[str, MetricWidgetData]:
        return {
            "revenue": MetricWidgetData(
                label=_("Revenue this month"),
                value="142 500",
                unit="₽",
                trend_value="+12%",
                trend_label=_("vs last month"),
                trend_direction="up",
                icon="bi-currency-ruble",
            ),
{%- if with_booking %}
            "bookings": MetricWidgetData(
                label=_("Bookings this month"),
                value="342",
                trend_value="+5%",
                trend_direction="up",
                icon="bi-calendar-check",
            ),
{%- endif %}
            "clients": MetricWidgetData(
                label=_("Total clients"),
                value="1 205",
                trend_value="+24",
                trend_label=_("this week"),
                trend_direction="up",
                icon="bi-people",
            ),
            "avg_check": MetricWidgetData(
                label=_("Average check"),
                value="2 450",
                unit="₽",
                trend_value="-3%",
                trend_label=_("vs last month"),
                trend_direction="down",
                icon="bi-receipt",
            ),
        }

    @staticmethod
    def get_chart_data() -> dict[str, dict[str, Any]]:
        """Raw chart config dicts consumed by dashboard chart widgets."""
        return {
            "revenue_chart": {
                "chart_id": "revenueChart",
                "title": _("Revenue"),
                "subtitle": _("last 7 days"),
                "icon": "bi-graph-up",
                "type": "line",
                "kpi_value": "142 500 ₽",
                "kpi_trend": "+12%",
                "kpi_trend_label": _("vs last month"),
                "chart_labels": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
                "chart_data": [12000, 15000, 11000, 18000, 22000, 31000, 28000],
                "color": "#4f46e5",
                "bg_color": "rgba(79, 70, 229, 0.1)",
            },
            "services_donut": {
                "chart_id": "servicesDonut",
                "title": _("Popular services"),
                "icon": "bi-pie-chart",
                "chart_labels": ["Haircut", "Coloring", "Styling", "Care"],
                "chart_data": [45, 30, 15, 10],
                "colors": ["#4f46e5", "#818cf8", "#c7d2fe", "#f1f5f9"],
            },
        }

    @staticmethod
    def get_top_lists() -> dict[str, ListWidgetData]:
        return {
            "top_masters": ListWidgetData(
                title=_("Top specialists"),
                subtitle=_("this month"),
                icon="bi-star",
                items=[
                    ListItem(label="Elena S.", value="120 000 ₽", avatar="ES", sublabel="45 sessions"),
                    ListItem(label="Anna M.", value="98 000 ₽", avatar="AM", sublabel="38 sessions"),
                    ListItem(label="Olga K.", value="75 000 ₽", avatar="OK", sublabel="30 sessions"),
                ],
            ),
            "top_services": ListWidgetData(
                title=_("Top services"),
                subtitle=_("this month"),
                icon="bi-scissors",
                items=[
                    ListItem(label="Manicure with coating", value="24 000 ₽", sublabel="48 times"),
                    ListItem(label="Women's haircut", value="18 500 ₽", sublabel="32 times"),
                    ListItem(label="Coloring", value="15 000 ₽", sublabel="12 times"),
                ],
            ),
        }

    @staticmethod
    def get_report_page(request: HttpRequest) -> ReportPageData:
        """Return a fully typed ReportPageData for the analytics reports view.

        Uses codex_django.cabinet.reports types — independently testable
        without a running HTTP server.
        """
        active_tab = request.GET.get("tab", "revenue")
        period = resolve_report_period(request.GET.get("period"))

        tabs = [
            ReportTabData(key="revenue", label=str(_("Revenue")), icon="bi-currency-ruble"),
            ReportTabData(key="services", label=str(_("Services")), icon="bi-scissors"),
            ReportTabData(key="masters", label=str(_("Specialists")), icon="bi-people"),
        ]
        period_options = [
            ReportTabData(key="week", label=str(_("Week"))),
            ReportTabData(key="month", label=str(_("Month"))),
            ReportTabData(key="quarter", label=str(_("Quarter"))),
        ]

{%- if with_booking %}
        columns = [
            TableColumn(key="label", label=str(_("Period")), bold=True),
            TableColumn(key="revenue_fmt", label=str(_("Revenue")), align="right"),
            TableColumn(key="bookings", label=str(_("Bookings")), align="right"),
            TableColumn(key="conversion", label=str(_("Conversion")), align="right"),
        ]
        rows = [
            {"label": "Week 1", "revenue_fmt": "35 000 ₽", "bookings": 42, "conversion": "68%"},
            {"label": "Week 2", "revenue_fmt": "31 500 ₽", "bookings": 38, "conversion": "64%"},
            {"label": "Week 3", "revenue_fmt": "40 000 ₽", "bookings": 47, "conversion": "72%"},
            {"label": "Week 4", "revenue_fmt": "36 000 ₽", "bookings": 44, "conversion": "70%"},
        ]
        summary_row = {"label": str(_("Total")), "revenue_fmt": "142 500 ₽", "bookings": 171, "conversion": "68%"}
{%- else %}
        columns = [
            TableColumn(key="label", label=str(_("Period")), bold=True),
            TableColumn(key="revenue_fmt", label=str(_("Revenue")), align="right"),
            TableColumn(key="conversion", label=str(_("Conversion")), align="right"),
        ]
        rows = [
            {"label": "Week 1", "revenue_fmt": "35 000 ₽", "conversion": "68%"},
            {"label": "Week 2", "revenue_fmt": "31 500 ₽", "conversion": "64%"},
            {"label": "Week 3", "revenue_fmt": "40 000 ₽", "conversion": "72%"},
            {"label": "Week 4", "revenue_fmt": "36 000 ₽", "conversion": "70%"},
        ]
        summary_row = {"label": str(_("Total")), "revenue_fmt": "142 500 ₽", "conversion": "68%"}
{%- endif %}

        chart = ReportChartData(
            chart_id="revenueReportChart",
            title=str(_("Revenue")),
            labels=["Week 1", "Week 2", "Week 3", "Week 4"],
            datasets=[
                ChartDatasetData(
                    label=str(_("Revenue ₽")),
                    data=[35000, 31500, 40000, 36000],
                    border_color="#4f46e5",
                    background_color="rgba(79,70,229,0.1)",
                    tension=0.4,
                    fill=True,
                ),
            ],
            type="line",
            description=str(_("Weekly revenue breakdown")),
            icon="bi-graph-up",
        )

        summary_cards = [
            ReportSummaryCardData(
                label=str(_("Total revenue")),
                value=str(summary_row["revenue_fmt"]),
                icon="bi-currency-ruble",
                trend_value="+12%",
                trend_direction="up",
            ),
        ]

        return ReportPageData(
            title=str(_("Analytics Reports")),
            summary=str(_("Overview for %(period_key)s") % {"period_key": period.key}),
            active_tab=active_tab,
            active_period=period.key,
            tabs=tabs,
            period_options=period_options,
            period_label=str(_("Reporting period")),
            table=ReportTableData(
                columns=columns,
                rows=rows,
                summary_row=summary_row,
                primary_summary=str(summary_row["revenue_fmt"]),
            ),
            chart=chart,
            summary_cards=summary_cards,
        )


# --- Register Dashboard Providers ---


@DashboardSelector.extend(cache_key="analytics_kpis", cache_ttl=300)  # type: ignore[untyped-decorator]
def provide_analytics_kpis(request: Any) -> Any:
    return AnalyticsService.get_kpi_metrics()


@DashboardSelector.extend(cache_key="analytics_charts", cache_ttl=300)  # type: ignore[untyped-decorator]
def provide_analytics_charts(request: Any) -> Any:
    return AnalyticsService.get_chart_data()


@DashboardSelector.extend(cache_key="analytics_lists", cache_ttl=300)  # type: ignore[untyped-decorator]
def provide_analytics_lists(request: Any) -> Any:
    return AnalyticsService.get_top_lists()
